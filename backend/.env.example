#Configuração do banco de dados postgreSQL
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pieiv_db

#String de conexão completa do SQLAlchemy
DATABASE_URL=postgresql+psycopg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

#Configuração de CORS
FRONTEND_URL=http://localhost:3000

#Segredo para assinar os tokens JWT (gere um valor aleatório longo)
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes-ou-mais
